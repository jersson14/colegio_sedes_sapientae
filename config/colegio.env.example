# Configuración del sistema (Fase 0.4). Plantilla SIN secretos.
#
# Copia este archivo FUERA del docroot, en la carpeta padre de htdocs:
#   XAMPP:      C:\xampp\colegio_config\colegio.env
#   Linux:      /var/www/colegio_config/colegio.env   (permisos 640, dueño root:www-data)
#   Hostinger:  /home/<usuario>/domains/<dominio>/colegio_config/colegio.env   (al lado de public_html)
# u otra ruta indicada con la variable de entorno COLEGIO_ENV (SetEnv en Apache).

# Base de datos. En producción NUNCA root: usa el usuario de config/usuario_bd.sql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=colegio
DB_USER=colegio_app
DB_PASS=cambia_esta_contraseña

# sql_mode de la sesión. El sistema se construyó sobre el modo permisivo de XAMPP; con el modo estricto
# por defecto de otros servidores muchas pantallas fallan con 500. No cambiar sin pruebas.
# DB_SQL_MODE=NO_ZERO_IN_DATE,NO_ZERO_DATE,NO_ENGINE_SUBSTITUTION

# true solo en desarrollo: muestra errores de PHP en el navegador.
APP_DEBUG=false

# Zona horaria de PHP y de la sesión de MySQL (por defecto America/Lima, sea cual sea la del servidor).
# APP_ZONA_HORARIA=America/Lima

# Días que se conserva la auditoría de cada institución (la borra el cron; mínimo 30).
# AUDITORIA_DIAS=730

# --- Instituciones (Fase 4) ---------------------------------------------------------------------
# unico    = una institución por instalación; la base es DB_NAME (hosting compartido, instancia dedicada).
# multiple = varias instituciones en el mismo servidor; el subdominio elige la base (SaaS en VPS).
MODO_TENANT=unico

# Solo modo unico: identificador de la institución (minúsculas, dígitos y guiones).
# TENANT_SLUG=principal

# Solo modo multiple: <slug>.TENANT_DOMINIO abre la base que la BD maestra asigna a ese slug.
# TENANT_DOMINIO=miapp.pe
# MAESTRO_DB_NAME=sge_maestro
# Cobros (tools/facturacion.php): días para pagar desde la emisión y de gracia antes de pasar a MOROSO.
# FACTURA_DIAS_PAGO=10
# FACTURA_DIAS_GRACIA=5
# Días que se conservan los datos de una institución CANCELADA antes de poder borrarlos (retención pactada).
# RETENCION_DIAS_BAJA=90
# Días que una institución SUSPENDIDA puede entrar a descargar sus datos (después responde 404).
# SUSPENSION_DIAS_EXPORTACION=30
# Panel de superadministrador (https://SUPERADMIN_HOST/superadmin/). Vacío = sin panel.
# SUPERADMIN_HOST=panel.miapp.pe
# Usuario propio para la maestra (opcional; por defecto DB_USER). Con panel: SELECT/INSERT/UPDATE en ella.
# MAESTRO_DB_USER=
# MAESTRO_DB_PASS=

# --- Módulos opcionales ------------------------------------------------------------------------
# Modo multiple: se activan por institución en el panel de superadministrador (columna «Módulos»).
# Modo unico: la lista separada por comas (facturacion_electronica, asistente_ia). Vacío = ninguno.
# MODULOS_ACTIVOS=facturacion_electronica
# Clave con la que se cifran los secretos de cada institución (token de Nubefact). 32 bytes en base64:
#   php -r "echo base64_encode(random_bytes(32));"
# ¡Respáldala aparte! Sin ella no se pueden leer los tokens guardados (habría que volver a ingresarlos).
# APP_CLAVE_CIFRADO=
# Solo pruebas: hosts adicionales permitidos como ruta de Nubefact (el falso de tests/E2E).
# NUBEFACT_HOSTS_PERMITIDOS=127.0.0.1:8097
# Asistente de IA: la clave de la API de Anthropic es de la plataforma (el consumo lo paga ella).
# ANTHROPIC_API_KEY=
# IA_MODELO=claude-opus-5-5
# IA_ESFUERZO=medium
# Modo unico: consultas al mes de la institución (vacío = sin límite). En modo multiple, en el panel.
# IA_LIMITE_MENSUAL=
# Consultas por usuario y hora (evita abusos).
# IA_LIMITE_USUARIO_HORA=20
# Solo pruebas: otra URL para la API (la falsa de tests/E2E).
# IA_BASE_URL=http://127.0.0.1:8096

# Archivos subidos (Fase 4.6): <ALMACEN_DIR>/<slug>/. Por defecto storage/tenants/ del proyecto (cerrado
# por .htaccess); mejor fuera del docroot si el servidor lo permite.
# ALMACEN_DIR=/var/www/colegio_almacen

# Copias de seguridad (tools/respaldo_tenant.php): carpeta de los respaldos y de mysqldump/mysql si no
# están en el PATH. Por defecto <carpeta de este archivo>/respaldos.
# RESPALDO_DIR=/var/backups/colegio
# MYSQL_BIN_DIR=C:/xampp/mysql/bin

# Migraciones (vendor/bin/phinx, tools/migrar_tenants.php): usuario con permisos DDL. Si falta, DB_USER.
# DB_MIGRACION_USER=
# DB_MIGRACION_PASS=
