# Configuración del sistema (Fase 0.4). Plantilla SIN secretos.
#
# Copia este archivo FUERA del docroot, en la carpeta padre de htdocs:
#   XAMPP:  C:\xampp\colegio_config\colegio.env
#   Linux:  /var/www/colegio_config/colegio.env   (permisos 640, dueño root:www-data)
# u otra ruta indicada con la variable de entorno COLEGIO_ENV (SetEnv en Apache).

# Base de datos. En producción NUNCA root: usa el usuario de config/usuario_bd.sql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=colegio
DB_USER=colegio_app
DB_PASS=cambia_esta_contraseña

# sql_mode de la sesión. El sistema se construyó sobre el modo permisivo de XAMPP; con el modo estricto
# por defecto de otros servidores muchas pantallas fallan con 500. No cambiar sin pruebas.
# DB_SQL_MODE=NO_ZERO_IN_DATE,NO_ZERO_DATE,NO_ENGINE_SUBSTITUTION

# true solo en desarrollo: muestra errores de PHP en el navegador.
APP_DEBUG=false
