# Archivos subidos por los usuarios (fotos, documentos de tareas)
controller/*/fotos/*
controller/*/FOTOS/*
controller/tareas/**/documentos/
!controller/*/fotos/.htaccess
!controller/*/FOTOS/.htaccess

# Configuración local con credenciales
config/config.local.php

# Respaldos de base de datos
respaldos/*

# Logs
logs/*.log

# Vouchers de pago subidos
controller/pago_pension/vouchers/*
!controller/pago_pension/vouchers/.htaccess

# Comprobantes de egresos subidos
controller/egresos/comprobantes/*
!controller/egresos/comprobantes/.htaccess

# Temporales de las pruebas
tests/tmp/

# El .htaccess de respaldos sí se versiona
!respaldos/.htaccess
# Material de apoyo del aula virtual
controller/aula_virtual/material/*
!controller/aula_virtual/material/.htaccess
