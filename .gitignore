# === Archivos subidos por usuarios ===
# NUNCA versionar fotografías ni adjuntos de personas.
# Cubre mayúsculas/minúsculas y cualquier nivel de anidamiento.
# (Se ignora el CONTENIDO y no la carpeta, para que las excepciones de abajo funcionen:
# git no puede re-incluir archivos dentro de una carpeta excluida.)
controller/**/fotos/*
controller/**/FOTOS/*
controller/tareas/documentos/
# Ruta física real de las tareas (las rutas de la BD son relativas a controller/tareas/).
controller/tareas/controller/tareas/documentos/
storage/*
!storage/README.md

# === Dumps de base de datos ===
# No se publican credenciales ni datos, ni de piloto ni reales.
*.sql
# Excepción: script del usuario de BD con privilegios mínimos (sin datos ni secretos).
!config/usuario_bd.sql
# Excepción: esquema SIN datos (estructura, procedimientos y eventos) para Phinx.
!database/esquema/*.sql
# Excepción: datos de prueba ANONIMIZADOS (tools/generar_datos_prueba.php verifica que no haya reales).
!database/seeders/datos_prueba.sql

# === Credenciales ===
# Viven en colegio.env FUERA del docroot (core/config.php). Los archivos de conexión
# ya no tienen secretos y se versionan. Por si alguien deja un .env dentro del proyecto:
.env
.env.*
*.env
!config/colegio.env.example

# === Dependencias ===
/node_modules/
/vendor/
view/MPDF/vendor/

# === Archivos de diagnóstico y prueba (hallazgo H-09) ===
phpinfo.php
prueba.php
test_*.php
test_*.html

# === Sistema operativo y editores ===
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.log

# Excepción: VACIO.png es la imagen por defecto de la aplicación
# (referenciada en controller/*/controlador_modificar_foto_*.php y js/console_alumnos.js),
# no es una subida de usuario. Debe versionarse.
!controller/**/fotos/VACIO.png

# Excepción: el .htaccess que impide ejecutar código en las carpetas de subidas (Fase 0.3).
!controller/**/fotos/.htaccess
!controller/**/FOTOS/.htaccess

# === Herramientas de calidad (Fase 1) ===
/.phpunit.cache/
/.php-cs-fixer.cache
/var/
/tests/E2E/node_modules/
