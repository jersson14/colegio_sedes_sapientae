Options -Indexes

# ---------------------------------------------------------------------------
# Fase 0 — nada interno se sirve por HTTP (detectado con OWASP ZAP, 2026-10-07)
# ---------------------------------------------------------------------------

# Archivos y carpetas ocultos: .git/ (todo el historial), .githooks/, .gitignore, .env…
# 404 en vez de 403 para no confirmar que existen. Se respeta /.well-known/ (certificados).
RedirectMatch 404 "/\.(?!well-known/)"

# Carpetas de desarrollo e infraestructura (Fase 1): solo se usan desde PHP o la consola.
# El patrón es relativo a la raíz del proyecto: no afecta a plugins con carpetas homónimas.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(vendor|node_modules|tests|database|storage|src|tools|config)(/|$) - [R=404,L]
    # En hosting compartido el proyecto ES public_html: las herramientas de consola y Phinx tampoco se sirven.
    RewriteRule ^phinx(_maestro)?\.php$ - [R=404,L]
    # Fase 4.7: la página pública es la de la institución del host (landing.php decide qué mostrar).
    RewriteRule ^landing\.html$ landing.php [L]
    # Fase 4.6: las fotos subidas están en el almacén de cada institución, no en estas carpetas. Si la
    # URL no es un archivo real (los de antes de la Fase 4 y VACIO.png sí lo son), se sirve con sesión.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^controller/((alumnos|docentes|personal_administrativo|comunicados)/fotos|(empleado|empresa)/FOTOS)/[^/]+$ controller/archivo/controlador_ver_archivo.php?ruta=$0 [L,QSA]
</IfModule>

# Dumps, documentación interna, manuales y metadatos de dependencias.
<FilesMatch "(?i)(\.(sql|md|docx?|log|bak|old|orig|ini|lock|ya?ml|sh|py|dist)|^(composer|package)(-lock)?\.json)$">
    Require all denied
</FilesMatch>

# Archivos descargables: siempre como adjunto (regla original).
<FilesMatch "(?i)\.(pdf|doc|docx)$">
    ForceType application/octet-stream
    Header set Content-Disposition attachment
</FilesMatch>

# ---------------------------------------------------------------------------
# Cabeceras de seguridad (hallazgo H-11)
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    # CSP base: impide incrustar la app en otros sitios, plugins y <base>/<form> hacia fuera.
    # script-src todavía no se restringe: la app usa scripts y onclick en línea (Fase 3).
    Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    # No anunciar la versión de PHP. (La de Apache se oculta en httpd.conf:
    # ServerTokens Prod y ServerSignature Off — ver docs/DESPLIEGUE.md.)
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>
