# Fase 0.3-B: los archivos de tareas solo se sirven a través de
# controller/tareas/controlador_descargar_tarea.php (con sesión y rol).
Require all denied
Options -Indexes

<IfModule php_module>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<FilesMatch "(?i)\.(php\d*|phtml|phar|pht|phps|inc|cgi|pl|py|rb|asp|aspx|jsp|sh|shtml|htaccess|htpasswd)$">
    Require all denied
</FilesMatch>
