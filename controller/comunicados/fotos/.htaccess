# Fase 0.3: carpeta de archivos subidos. Nada de aquí se ejecuta como código.
<IfModule php_module>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<FilesMatch "(?i)\.(php\d*|phtml|phar|pht|phps|inc|cgi|pl|py|rb|asp|aspx|jsp|sh|shtml|htaccess|htpasswd)$">
    Require all denied
</FilesMatch>
